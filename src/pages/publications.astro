---
import copy from '@/data/editor/publications.json';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PubList from '@/components/PubList.tsx';
import { publications, myNameVariants } from '@/data/cv';
import { SOCIAL, sitePath } from '@/consts';

const ld = publications.map((p) => ({
  '@context': 'https://schema.org',
  '@type': 'ScholarlyArticle',
  headline: p.title,
  name: p.title,
  datePublished: String(p.year),
  isPartOf: { '@type': p.type === 'journal' ? 'Periodical' : 'Book', name: p.venue },
  ...(p.doi ? { sameAs: `https://doi.org/${p.doi}`, identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: p.doi } } : {}),
  author: { '@id': new URL(sitePath('/#person'), Astro.site).href },
  keywords: p.tags.join(', '),
}));
---
<Base title="Publications" description="Journal articles and conference papers on phase-change metasurfaces and thermal transport in 2D materials, with BibTeX." jsonLd={ld}>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <span class="rule" aria-hidden="true"></span>
      <p>{copy.introduction}</p>
      {SOCIAL.scholar && (
        <p class="profile-links">
          <a class="btn btn-ghost" href={SOCIAL.scholar} rel="me noopener noreferrer" target="_blank"><Icon name="scholar" /> Google Scholar</a>
          {SOCIAL.researchgate && <a class="btn btn-ghost" href={SOCIAL.researchgate} rel="me noopener noreferrer" target="_blank"><Icon name="researchgate" /> ResearchGate</a>}
        </p>
      )}
    </div>
  </header>

  <section class="container section pub-wrap">
    <PubList client:load pubs={publications} myNames={myNameVariants} />
  </section>
</Base>

<style>
  .profile-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 24px !important; }
  .profile-links :global(.btn) { padding: 9px 18px; }
  .pub-wrap :global(.pub-toolbar) { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; margin-bottom: 8px; }
  .pub-wrap :global(.seg) { display: inline-flex; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 4px; }
  .pub-wrap :global(.seg button) { border: 0; background: transparent; padding: 7px 18px; border-radius: 999px; cursor: pointer; color: var(--ink-2); font-family: var(--font-sans); transition: color 0.2s, background-color 0.2s; }
  .pub-wrap :global(.seg button:hover) { color: var(--ink); }
  .pub-wrap :global(.seg button.active) { background: var(--grad); color: #fff; box-shadow: 0 4px 14px rgb(139 92 246 / 0.35); }
  .pub-wrap :global(.pub-search input) { font: inherit; font-family: var(--font-sans); font-size: 0.95rem; padding: 9px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink); width: min(340px, 80vw); transition: border-color 0.2s, box-shadow 0.2s; }
  .pub-wrap :global(.pub-search input:focus) { outline: none; border-color: var(--violet); box-shadow: 0 0 0 4px rgb(139 92 246 / 0.18); }
  .pub-wrap :global(.pub-year h2) { display: flex; align-items: center; gap: 14px; font: 700 1.7rem/1 var(--font-display); margin: 40px 0 16px; color: var(--ink); font-variant-numeric: tabular-nums; }
  .pub-wrap :global(.pub-year h2::after) { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--line), transparent); }
  .pub-wrap :global(.pub-year ol) { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .pub-wrap :global(.pub) { padding: 20px 24px; scroll-margin-top: calc(var(--header-h) + 20px); overflow: hidden; }
  .pub-wrap :global(.pub::after) { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--grad); transform: scaleY(0); transform-origin: top; transition: transform 0.45s var(--ease-out); }
  .pub-wrap :global(.pub:hover::after), .pub-wrap :global(.pub:target::after) { transform: scaleY(1); }
  .pub-wrap :global(.pub:target) { border-color: var(--violet); box-shadow: var(--glow); }
  .pub-wrap :global(.pub-head) { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px; }
  .pub-wrap :global(.badge) { font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.06em; padding: 3px 10px; border-radius: 999px; }
  .pub-wrap :global(.badge.journal) { background: var(--teal-bg); color: var(--teal); }
  .pub-wrap :global(.badge.conference) { background: var(--amber-bg); color: var(--amber); }
  .pub-wrap :global(.pub h3) { font-size: 1.22rem; margin: 0 0 8px; line-height: 1.3; }
  .pub-wrap :global(.pub h3 a) { color: var(--ink); text-decoration: none; }
  .pub-wrap :global(.pub h3 a:hover) { color: var(--violet-ink); text-decoration: underline; }
  .pub-wrap :global(.pub-authors), .pub-wrap :global(.pub-venue) { margin: 0; color: var(--ink-2); font-size: 1rem; }
  .pub-wrap :global(.me) { color: var(--ink); font-weight: 600; text-decoration: underline; text-decoration-color: var(--violet); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .pub-wrap :global(.pub-actions) { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
  .pub-wrap :global(.pub-actions button), .pub-wrap :global(.pub-actions a) {
    font-family: var(--font-sans); font-size: 0.82rem; padding: 6px 14px; border-radius: 999px; border: 1px solid var(--line);
    background: var(--surface-2); color: var(--ink); cursor: pointer; text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.3s var(--ease-spring);
  }
  .pub-wrap :global(.pub-actions button:hover), .pub-wrap :global(.pub-actions a:hover) { border-color: var(--violet); color: var(--violet-ink); transform: translateY(-2px); }
  .pub-wrap :global(.pub-actions button:active) { transform: scale(0.95); }
  .pub-wrap :global(.pub-bib) { margin: 12px 0 0; background: #0a0d1f; color: #e6e9f7; border: 1px solid #1d2347; padding: 14px 16px; border-radius: var(--radius-sm); overflow-x: auto; font: 0.84rem/1.55 var(--font-mono); user-select: all; animation: rise 0.35s var(--ease-out); }
  .pub-wrap :global(.pub-empty) { color: var(--ink-2); margin-top: 24px; }
</style>
