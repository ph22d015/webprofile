---
import Base from '@/layouts/Base.astro';
---
<Base title="Site administration" noindex>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Site administration</p>
      <h1>Portfolio editor</h1>
      <p>Sign in to manage your pages, publications, posts and photographs.</p>
      <a class="btn btn-primary" href="https://app.pagescms.org/ph22d015/webprofile/main">Continue with GitHub</a>
    </div>
  </header>
  <section class="container section">
    <h2>First sign-in</h2>
    <p>In Pages CMS, authorize the GitHub app for <strong>ph22d015/webprofile</strong> and open the <strong>main</strong> branch. Choose a section, edit its fields and save. Your changes appear here after GitHub Pages finishes rebuilding.</p>
  </section>
</Base>
<style>
  .btn { margin-top: 1.25rem; }
  .section p { max-width: 62ch; }
</style>
