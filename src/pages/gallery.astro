---
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';

// Drop photos into src/assets/gallery/<album-name>/ — that's it.
// Album = folder name; caption = file name ("sunset-ridge.jpg" → "Sunset ridge").
// Every image is re-encoded at build time, which strips EXIF (GPS, camera serial numbers).
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/gallery/**/*.{jpg,jpeg,png,webp,avif}', { eager: true });

const nice = (s: string) => s.replace(/[-_]+/g, ' ').replace(/^\w/, (c) => c.toUpperCase());

type Photo = { src: ImageMetadata; album: string; caption: string; full: string; fullW: number; fullH: number };
const photos: Photo[] = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => b.localeCompare(a))
    .map(async ([path, mod]) => {
      const parts = path.split('/');
      const file = parts.pop()!.replace(/\.[^.]+$/, '');
      const album = parts.pop()!;
      const full = await getImage({ src: mod.default, format: 'webp', width: Math.min(mod.default.width, 2000), quality: 82 });
      return {
        src: mod.default,
        album: album === 'gallery' ? 'Misc' : nice(album),
        caption: nice(file),
        full: full.src,
        fullW: Number(full.attributes.width),
        fullH: Number(full.attributes.height),
      };
    }),
);
const albums = [...new Set(photos.map((p) => p.album))];
---
<Base title="Gallery" description="Photographs by Sourav Mondal — travel, nature, and moments from the lab.">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h1>Through my lens</h1>
      <span class="rule" aria-hidden="true"></span>
      <p>Places, people and light. Photography is how I slow down outside the lab.</p>
    </div>
  </header>

  <section class="container section">
    {albums.length > 1 && (
      <div class="albums" role="group" aria-label="Filter by album">
        <button type="button" class="on" data-album="*" aria-pressed="true">All</button>
        {albums.map((a) => <button type="button" data-album={a} aria-pressed="false">{a}</button>)}
      </div>
    )}

    {photos.length === 0 ? (
      <p>No photos yet.</p>
    ) : (
      <ul class="masonry" data-grid>
        {photos.map((p, i) => (
          <li data-album={p.album}>
            <button type="button" class="tile" data-index={i} data-full={p.full} data-w={p.fullW} data-h={p.fullH} data-caption={p.caption} data-album-name={p.album} aria-label={`Open photo: ${p.caption}`}>
              <Image src={p.src} alt={p.caption} widths={[400, Math.min(p.src.width, 800)]} sizes="(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw" loading={i < 3 ? 'eager' : 'lazy'} />
              <span class="cap">{p.caption}</span>
            </button>
          </li>
        ))}
      </ul>
    )}
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Photo viewer">
    <figure>
      <img data-lb-img alt="" />
      <figcaption><span data-lb-cap></span> <span class="alb" data-lb-album></span> <span class="count" data-lb-count></span></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" data-lb-close aria-label="Close"><Icon name="close" /></button>
    <button type="button" class="lb-btn lb-prev" data-lb-prev aria-label="Previous photo"><Icon name="arrow" /></button>
    <button type="button" class="lb-btn lb-next" data-lb-next aria-label="Next photo"><Icon name="arrow" /></button>
  </dialog>
</Base>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const cap = document.querySelector<HTMLElement>('[data-lb-cap]');
  const alb = document.querySelector<HTMLElement>('[data-lb-album]');
  const count = document.querySelector<HTMLElement>('[data-lb-count]');
  const visible = () => [...document.querySelectorAll<HTMLButtonElement>('[data-grid] li:not([hidden]) .tile')];
  let current: HTMLButtonElement | null = null;

  function show(btn: HTMLButtonElement) {
    if (!dlg || !img || !cap || !alb || !count) return;
    current = btn;
    const list = visible();
    img.src = btn.dataset.full ?? '';
    img.width = Number(btn.dataset.w);
    img.height = Number(btn.dataset.h);
    img.alt = btn.dataset.caption ?? '';
    cap.textContent = btn.dataset.caption ?? '';
    alb.textContent = btn.dataset.albumName ?? '';
    count.textContent = `${list.indexOf(btn) + 1} / ${list.length}`;
    if (!dlg.open) dlg.showModal();
  }
  function step(dir: 1 | -1) {
    const list = visible();
    if (!current || !list.length) return;
    const i = (list.indexOf(current) + dir + list.length) % list.length;
    show(list[i]);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-grid] .tile').forEach((b) => b.addEventListener('click', () => show(b)));
  document.querySelector('[data-lb-close]')?.addEventListener('click', () => dlg?.close());
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('close', () => current?.focus());
  dlg?.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') step(1);
    if (e.key === 'ArrowLeft') step(-1);
  });
  // Swipe on touch screens
  let x0: number | null = null;
  dlg?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
  dlg?.addEventListener('touchend', (e) => {
    if (x0 === null) return;
    const dx = e.changedTouches[0].clientX - x0;
    if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
    x0 = null;
  });

  // Album filter
  const albumBtns = document.querySelectorAll<HTMLButtonElement>('.albums [data-album]');
  albumBtns.forEach((b) => b.addEventListener('click', () => {
    albumBtns.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    document.querySelectorAll<HTMLElement>('[data-grid] > li').forEach((li) => {
      li.hidden = b.dataset.album !== '*' && li.dataset.album !== b.dataset.album;
    });
  }));
</script>

<style>
  .albums { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 24px; }
  .albums button { font-family: var(--font-sans); font-size: 0.88rem; padding: 6px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); cursor: pointer; }
  .albums button.on { background: var(--grad); color: #fff; border-color: transparent; }

  .masonry { list-style: none; margin: 0; padding: 0; columns: 3 300px; column-gap: 16px; }
  .masonry li { break-inside: avoid; margin-bottom: 16px; }
  .masonry li[hidden] { display: none; }
  .tile { position: relative; display: block; width: 100%; padding: 0; border: 0; border-radius: 10px; overflow: hidden; cursor: zoom-in; background: var(--night-2); box-shadow: var(--shadow); }
  .tile :global(img) { width: 100%; height: auto; transition: transform 0.4s ease; }
  .tile:hover :global(img) { transform: scale(1.03); }
  .cap { position: absolute; inset: auto 0 0 0; padding: 28px 14px 10px; text-align: left; color: #fff; font-size: 0.95rem; background: linear-gradient(transparent, rgb(0 0 0 / 0.65)); opacity: 0; transition: opacity 0.2s ease; }
  .tile:hover .cap, .tile:focus-visible .cap { opacity: 1; }

  .lightbox { width: 100vw; height: 100vh; max-width: 100vw; max-height: 100vh; margin: 0; padding: 0; border: 0; background: rgb(5 7 18 / 0.96); color: #fff; }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.6); }
  .lightbox figure { margin: 0; height: 100%; display: grid; grid-template-rows: 1fr auto; place-items: center; padding: 56px 72px 16px; }
  .lightbox img { max-width: 100%; max-height: calc(100vh - 120px); width: auto; height: auto; object-fit: contain; border-radius: 6px; }
  .lightbox figcaption { padding: 12px 0 8px; color: #dfe2f5; display: flex; gap: 14px; align-items: baseline; }
  .alb, .count { font-family: var(--font-sans); font-size: 0.8rem; color: #9aa3c7; }
  .lb-btn { position: absolute; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgb(255 255 255 / 0.2); background: rgb(255 255 255 / 0.06); color: #fff; cursor: pointer; }
  .lb-btn:hover { background: rgb(255 255 255 / 0.14); }
  .lb-close { top: 14px; right: 14px; }
  .lb-prev { left: 14px; top: 50%; transform: translateY(-50%) rotate(180deg); }
  .lb-next { right: 14px; top: 50%; transform: translateY(-50%); }
  @media (max-width: 640px) { .lightbox figure { padding: 60px 8px 16px; } .lb-prev, .lb-next { top: auto; bottom: 14px; transform: none; } .lb-prev :global(svg) { transform: rotate(180deg); } }
</style>
