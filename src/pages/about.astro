---
import { siteImage } from '@/data/siteImages';
import copy from '@/data/editor/about.json';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { EMAIL, PROFILES, SITE } from '@/consts';
import { hobbies, languages } from '@/data/cv';
import { Content as Biography } from '@/data/editor/biography.md';

const profile = siteImage('profile');
---
<Base title="About" description="About Sourav Mondal: PhD researcher in phase-change photonics at IIT Madras, teacher, mentor and photographer." type="profile">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>Hi, I'm {SITE.shortName}.</h1>
      <span class="rule" aria-hidden="true"></span>
      <p>{SITE.role}, {SITE.department}, {SITE.institution}.</p>
    </div>
  </header>

  <section class="container section about">
    <div class="prose">
      <Biography />
    </div>

    <aside class="side">
      <div class="card me">
        <Image src={profile} alt={`Portrait of ${SITE.name}`} width={200} height={200} fit="cover" />
        <h2>{SITE.name}</h2>
        <p>{SITE.institution}</p>
        <p class="loc"><Icon name="pin" size={16} /> {SITE.location}</p>
      </div>
      <dl class="card facts">
        <div><dt>Languages</dt><dd>{languages.join(', ')}</dd></div>
        <div><dt>Interests</dt><dd>{hobbies.join(', ')}</dd></div>
      </dl>
    </aside>
  </section>

  <section class="container section contact" id="contact" aria-labelledby="contact-title">
    <div class="card contact-card">
      <div>
        <h2 id="contact-title">{copy.get_in_touch}</h2>
        <p>{copy.introduction}</p>
        <p class="mail">
          <a class="btn btn-primary" href="#contact" data-mail><Icon name="mail" /> <span data-mail-text>Enable JavaScript to see my e-mail</span></a>
        </p>
        <noscript><p>My e-mail is <code>{EMAIL.user} [at] {EMAIL.domain.replaceAll('.', ' [dot] ')}</code>.</p></noscript>
      </div>
      <ul class="profiles">
        {PROFILES.filter((p) => p.href).map((p) => (
          <li><a href={p.href} rel="me noopener noreferrer" target="_blank"><Icon name={p.icon} /> {p.label} <Icon name="external" size={14} /></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  // Base layout fills hrefs; here we also show the address as the button label.
  const src = document.querySelector<HTMLElement>('[data-mail-src]');
  const label = document.querySelector<HTMLElement>('[data-mail-text]');
  if (src && label) label.textContent = `${src.dataset.u}@${src.dataset.d}`;
</script>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 48px; align-items: start; }
  .side { display: grid; gap: 16px; position: sticky; top: calc(var(--header-h) + 20px); }
  .me { padding: 24px; text-align: center; }
  .me { overflow: hidden; }
  .me::after { content: ''; position: absolute; inset: 0 0 auto; height: 84px; z-index: -1; background: var(--grad); opacity: 0.18; }
  .me :global(img) { width: 132px; height: 132px; border-radius: 50%; object-fit: cover; margin: 0 auto 14px; padding: 4px; background: conic-gradient(from 0deg, var(--cyan), var(--violet), var(--magenta), var(--cyan)); box-shadow: 0 0 30px rgb(139 92 246 / 0.35); }
  .me h2 { font-size: 1.3rem; margin: 0 0 4px; }
  .me p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  .loc { display: inline-flex; align-items: center; gap: 6px; margin-top: 6px !important; }
  .facts { padding: 16px 20px; margin: 0; display: grid; gap: 12px; }
  .facts dt { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--violet-ink); }
  .facts dd { margin: 2px 0 0; }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; } .side { position: static; } }

  .contact { padding-top: 0; }
  .contact-card { padding: clamp(24px, 5vw, 48px); display: grid; grid-template-columns: 1.4fr 1fr; gap: 32px; align-items: center; overflow: hidden; }
  .contact-card::after { content: ''; position: absolute; z-index: -1; width: 420px; height: 420px; right: -140px; top: -180px; border-radius: 50%; background: radial-gradient(circle, rgb(139 92 246 / 0.22), rgb(34 211 238 / 0.08) 50%, transparent 70%); pointer-events: none; }
  .contact-card h2 { font-size: clamp(1.8rem, 3.5vw, 2.4rem); }
  .contact-card p { color: var(--ink-2); }
  .mail { margin-top: 18px !important; }
  .mail :global(.btn) { word-break: break-all; }
  .profiles { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .profiles a { display: flex; align-items: center; gap: 12px; padding: 12px 16px; border: 1px solid var(--line); border-radius: 14px; color: var(--ink); text-decoration: none; background: var(--surface); transition: border-color 0.2s, transform 0.35s var(--ease-spring), box-shadow 0.3s; }
  .profiles a:hover { border-color: var(--violet); transform: translateX(6px); box-shadow: var(--glow); }
  .profiles a :global(svg:last-child) { transition: transform 0.3s var(--ease-spring); }
  .profiles a:hover :global(svg:last-child) { transform: translate(2px, -2px); color: var(--violet-ink); }
  .profiles a :global(svg:last-child) { margin-left: auto; color: var(--ink-3); }
  @media (max-width: 760px) { .contact-card { grid-template-columns: 1fr; } }
</style>
