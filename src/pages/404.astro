---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import { sitePath } from '@/consts';
---
<Base title="Page not found" description="This page does not exist." noindex>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Error 404</p>
      <h1>This beam missed the detector.</h1>
      <span class="rule" aria-hidden="true"></span>
      <p>The page you were looking for does not exist or has moved.</p>
      <p class="go"><a class="btn btn-primary" href={sitePath("/")}>Back to home <Icon name="arrow" /></a></p>
    </div>
  </header>
</Base>

<style>
  .go { margin-top: 28px !important; }
</style>
