---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE } from '@/consts';
import { getPosts } from '@/lib/posts';

import hero from '@/assets/site/hero-lab.jpg';
import profile from '@/assets/site/profile.jpg';
import stack from '@/assets/site/photonic-stack.jpg';
import researchImg from '@/assets/site/research-card.jpg';
import pubsImg from '@/assets/site/publications.jpg';
import cvImg from '@/assets/site/cv-illustration.jpg';
import blogImg from '@/assets/site/blog-illustration.jpg';

const posts = (await getPosts()).slice(0, 3);
const [first, ...rest] = SITE.name.split(' ');

const cards = [
  { title: 'Research', icon: 'pulse', tone: 'violet', text: 'Optical phase change materials, ultrafast optics, photonic devices, and light–matter interaction.', href: '/research/', cta: 'Explore Research', img: researchImg, imgClass: 'img-dark' },
  { title: 'Publications', icon: 'doc', tone: 'teal', text: 'Journal articles, conference papers and preprints.', href: '/publications/', cta: 'View Publications', img: pubsImg, imgClass: 'img-light' },
  { title: 'CV & Experience', icon: 'briefcase', tone: 'amber', text: 'Education, research experience, skills, projects and achievements.', href: '/cv/', cta: 'View CV', img: cvImg, imgClass: 'img-light' },
  { title: 'Thoughts & Blog', icon: 'pen', tone: 'purple', text: 'Ideas, experiences, reflections on science, life and beyond.', href: '/blog/', cta: 'Read the Blog', img: blogImg, imgClass: 'img-light' },
] as const;
---
<Base type="profile">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <Image src={hero} alt="" widths={[665]} sizes="(max-width: 900px) 100vw, 60vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="container hero-inner">
      <div class="portrait">
        <Image src={profile} alt={`Portrait of ${SITE.name}`} width={220} height={220} loading="eager" fit="cover" position="center" />
      </div>
      <div class="hero-copy">
        <p class="eyebrow">{SITE.eyebrow.join('  |  ')}</p>
        <h1 id="hero-title">{first} <span class="grad">{rest.join(' ')}</span></h1>
        <p class="affil">{SITE.department}<br />{SITE.institution}</p>
        <span class="rule" aria-hidden="true"></span>
        <p class="intro">{SITE.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href="/cv/">View My CV <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href="/blog/">Read My Blog <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="hero-aside" aria-hidden="true">
        <p class="hand">
          {SITE.tagline.map((line, i) => <span class={`l${i}`}>{line}</span>)}
        </p>
        <Image src={stack} alt="" width={200} class="stack" />
      </div>
    </div>
  </section>

  <section class="container cards" aria-label="Sections">
    {cards.map((c) => (
      <article class="tile card">
        <div class="tile-text">
          <span class={`tile-icon ${c.tone}`}><Icon name={c.icon} size={24} /></span>
          <h2><a href={c.href}>{c.title}</a></h2>
          <p>{c.text}</p>
          <span class={`link-arrow ${c.tone}`}>{c.cta} <Icon name="arrow" /></span>
        </div>
        <Image src={c.img} alt="" width={180} class={`tile-img ${c.imgClass}`} />
      </article>
    ))}
  </section>

  <section class="container section recent" aria-labelledby="recent-title">
    <div class="section-head">
      <h2 id="recent-title" class="section-title">Recent Posts</h2>
      <a class="link-arrow" href="/blog/">View All Posts <Icon name="arrow" /></a>
    </div>
    <div class="post-grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative; overflow: hidden; color: var(--on-night);
    background: radial-gradient(900px 500px at 15% 30%, rgb(61 123 255 / 0.18), transparent 60%), var(--night);
    padding: calc(var(--header-h) + 44px) 0 40px; min-height: 460px;
  }
  .hero-art { position: absolute; inset: 0 0 0 30%; }
  .hero-art :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 38%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 38%);
    opacity: 0.95;
  }
  .hero::after { /* soft vignette so text stays readable */
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgb(7 11 29 / 0.95) 0%, rgb(7 11 29 / 0.6) 45%, rgb(7 11 29 / 0.1) 75%, transparent),
      linear-gradient(0deg, rgb(7 11 29 / 0.5), transparent 30%);
  }
  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(24px, 4vw, 48px); align-items: start; }

  .portrait {
    width: 196px; aspect-ratio: 1; border-radius: 50%; padding: 5px; margin-top: 4px;
    background: conic-gradient(from 200deg, var(--violet), var(--blue), #8ad4ff, var(--violet));
    box-shadow: 0 0 40px rgb(123 92 255 / 0.45);
  }
  .portrait :global(img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; transform: scale(1.12); }
  .portrait { overflow: hidden; }

  .eyebrow { font-family: var(--font-sans); font-size: 0.78rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--on-night-2); margin: 0 0 8px; white-space: pre; }
  h1 { font-size: clamp(2.8rem, 6vw, 4.2rem); margin: 0 0 6px; font-weight: 600; letter-spacing: -0.02em; }
  .grad { background: linear-gradient(90deg, #8f7bff, #6f9dff); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .affil { font-size: 1.2rem; color: #e3e6f6; margin: 0; line-height: 1.45; }
  .rule { display: block; width: 52px; height: 3px; border-radius: 2px; background: var(--grad); margin: 20px 0; }
  .intro { font-size: 1.15rem; color: #e3e6f6; max-width: 34em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 26px; }

  .hero-aside { position: relative; width: 240px; align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .hand { font-family: var(--font-hand); font-size: 1.85rem; line-height: 1.2; color: #dfe2ff; margin: 0; display: grid; text-shadow: 0 2px 12px rgb(0 0 0 / 0.6); }
  .hand .l1 { padding-left: 0.8em; }
  .hand .l2 { padding-left: 1.6em; }
  .hand .l3 { padding-left: 1.8em; white-space: nowrap; }
  .hand .l3::after { content: ''; display: block; width: 44px; height: 2px; margin: 10px 0 0 5em; background: var(--grad); }
  .hero-aside :global(.stack) { width: 200px; align-self: flex-end; mix-blend-mode: screen; opacity: 0.95;
    -webkit-mask-image: radial-gradient(closest-side, #000 70%, transparent); mask-image: radial-gradient(closest-side, #000 70%, transparent); }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: rise 0.6s ease both; }
    .hero-copy > :nth-child(2) { animation-delay: 0.05s; }
    .hero-copy > :nth-child(3) { animation-delay: 0.1s; }
    .hero-copy > :nth-child(5) { animation-delay: 0.15s; }
    .hero-copy > :nth-child(6) { animation-delay: 0.2s; }
    .hand span { animation: rise 0.7s ease both; }
    .hand .l1 { animation-delay: 0.2s; } .hand .l2 { animation-delay: 0.35s; } .hand .l3 { animation-delay: 0.5s; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  @media (max-width: 1100px) { .hero-aside { display: none; } .hero-inner { grid-template-columns: auto minmax(0, 1fr); } }
  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .portrait { width: 140px; }
    .hero-art { inset: 0; opacity: 0.45; }
    .eyebrow { white-space: normal; letter-spacing: 0.16em; }
  }

  /* ---------- Section cards ---------- */
  .cards { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-top: 20px; }
  .tile { position: relative; padding: 16px 18px 18px 20px; min-height: 196px; overflow: hidden; transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .tile:hover { transform: translateY(-3px); box-shadow: var(--shadow-hover); }
  .tile-text { display: flex; flex-direction: column; height: 100%; position: relative; z-index: 1; }
  .tile-icon { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; margin-bottom: 14px; }
  .tile-icon.violet { background: var(--purple-bg); color: var(--violet-ink); }
  .tile-icon.teal { background: var(--teal-bg); color: var(--teal); }
  .tile-icon.amber { background: var(--amber-bg); color: var(--amber); }
  .tile-icon.purple { background: var(--purple-bg); color: var(--violet-ink); }
  .tile h2 { font-size: 1.35rem; margin: 0 0 4px; }
  .tile h2 a { color: var(--ink); text-decoration: none; }
  .tile h2 a::after { content: ''; position: absolute; inset: -200px; z-index: 2; }
  .tile p { color: var(--ink-2); font-size: 0.95rem; line-height: 1.45; margin: 0 0 14px; max-width: 72%; }
  .tile .link-arrow { margin-top: auto; white-space: nowrap; }
  .link-arrow.violet { color: var(--blue-ink); }
  .link-arrow.teal { color: var(--teal); }
  .link-arrow.amber { color: var(--amber); }
  .link-arrow.purple { color: var(--violet-ink); }
  .tile :global(.tile-img) { position: absolute; z-index: 0; right: 10px; top: 14px; width: 40%; max-width: 150px; height: auto; pointer-events: none; }
  .tile :global(.img-dark) { border-radius: 6px; aspect-ratio: 3 / 4; object-fit: cover; width: 34%; max-width: 112px; }
  .tile :global(.img-light) { top: auto; bottom: 10px; mix-blend-mode: multiply; opacity: 0.85;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%); }
  .tile:has(.img-dark) p { max-width: 62%; }
  @media (prefers-color-scheme: dark) { .tile :global(.img-light) { mix-blend-mode: screen; filter: invert(1) hue-rotate(180deg); opacity: 0.6; } }

  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }

  /* ---------- Recent posts ---------- */
  .recent { padding-top: 40px; }
  .post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  @media (max-width: 960px) { .post-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .post-grid { grid-template-columns: 1fr; } }
</style>
