---
import { siteImage } from '@/data/siteImages';
import copy from '@/data/editor/home.json';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import PostCard from '@/components/PostCard.astro';
import { SITE, sitePath } from '@/consts';
import { getPosts } from '@/lib/posts';

const hero = siteImage('hero');
const profile = siteImage('profile');
const stack = siteImage('stack');
const researchImg = siteImage('researchImg');
const pubsImg = siteImage('pubsImg');
const cvImg = siteImage('cvImg');
const blogImg = siteImage('blogImg');


const posts = (await getPosts()).slice(0, 3);
const [first, ...rest] = SITE.name.split(' ');

const cards = [
  { title: copy.cards.research.title, icon: 'pulse', tone: 'violet', text: copy.cards.research.description, href: sitePath('/research/'), cta: copy.cards.research.button, img: researchImg, imgClass: 'img-dark' },
  { title: copy.cards.publications.title, icon: 'doc', tone: 'teal', text: copy.cards.publications.description, href: sitePath('/publications/'), cta: copy.cards.publications.button, img: pubsImg, imgClass: 'img-light' },
  { title: copy.cards.cv.title, icon: 'briefcase', tone: 'amber', text: copy.cards.cv.description, href: sitePath('/cv/'), cta: copy.cards.cv.button, img: cvImg, imgClass: 'img-light' },
  { title: copy.cards.blog.title, icon: 'pen', tone: 'purple', text: copy.cards.blog.description, href: sitePath('/blog/'), cta: copy.cards.blog.button, img: blogImg, imgClass: 'img-light' },
] as const;
---
<Base type="profile">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-art" aria-hidden="true">
      <Image src={hero} alt="" widths={[665]} sizes="(max-width: 900px) 100vw, 60vw" loading="eager" fetchpriority="high" />
    </div>
    <svg class="waves" viewBox="0 0 1200 300" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 150 Q75 60 150 150 T300 150 T450 150 T600 150 T750 150 T900 150 T1050 150 T1200 150 T1350 150 T1500 150" />
      <path d="M0 170 Q100 100 200 170 T400 170 T600 170 T800 170 T1000 170 T1200 170 T1400 170 T1600 170" />
      <path d="M0 190 Q60 150 120 190 T240 190 T360 190 T480 190 T600 190 T720 190 T840 190 T960 190 T1080 190 T1200 190 T1320 190 T1440 190" />
    </svg>
    <div class="container hero-inner">
      <div class="portrait">
        <span class="orbit" aria-hidden="true"></span>
        <Image src={profile} alt={`Portrait of ${SITE.name}`} width={220} height={220} loading="eager" fit="cover" position="center" />
      </div>
      <div class="hero-copy">
        <p class="eyebrow">{SITE.eyebrow.join('  |  ')}</p>
        <h1 id="hero-title">{first} <span class="grad-text">{rest.join(' ')}</span></h1>
        <p class="affil">{SITE.department}<br />{SITE.institution}</p>
        <span class="rule" aria-hidden="true"></span>
        <p class="intro">{SITE.intro}</p>
        <div class="ctas">
          <a class="btn btn-primary" href={sitePath("/cv/")}>View My CV <Icon name="arrow" /></a>
          <a class="btn btn-ghost" href={sitePath("/blog/")}>Read My Blog <Icon name="arrow" /></a>
        </div>
      </div>
      <div class="hero-aside" aria-hidden="true">
        <p class="hand">
          {SITE.tagline.map((line, i) => <span class={`l${i}`}>{line}</span>)}
        </p>
        <Image src={stack} alt="" width={200} class="stack" />
      </div>
    </div>
  </section>

  <section class="container cards" aria-label="Sections">
    {cards.map((c) => (
      <article class="tile card">
        <div class="tile-text">
          <span class={`tile-icon ${c.tone}`}><Icon name={c.icon} size={24} /></span>
          <h2><a href={c.href}>{c.title}</a></h2>
          <p>{c.text}</p>
          <span class={`link-arrow ${c.tone}`}>{c.cta} <Icon name="arrow" /></span>
        </div>
        <Image src={c.img} alt="" width={180} class={`tile-img ${c.imgClass}`} />
      </article>
    ))}
  </section>

  <section class="container section recent" aria-labelledby="recent-title">
    <div class="section-head">
      <h2 id="recent-title" class="section-title">{copy.recent_posts}</h2>
      <a class="link-arrow" href={sitePath("/blog/")}>View All Posts <Icon name="arrow" /></a>
    </div>
    <div class="post-grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative; overflow: hidden; isolation: isolate; color: var(--on-night);
    background:
      radial-gradient(700px 420px at 12% 20%, rgb(139 92 246 / 0.28), transparent 65%),
      radial-gradient(600px 400px at 40% 110%, rgb(34 211 238 / 0.18), transparent 65%),
      var(--night);
    padding: calc(var(--header-h) + 64px) 0 88px; min-height: 520px;
  }
  .hero-art { position: absolute; inset: 0 0 0 32%; z-index: -2; }
  .hero-art :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: center;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 40%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 40%);
    opacity: 0.85; filter: saturate(1.15);
  }
  .hero::after { /* vignette keeps the copy readable */
    content: ''; position: absolute; inset: 0; pointer-events: none; z-index: -1;
    background: linear-gradient(90deg, rgb(5 6 15 / 0.95) 0%, rgb(5 6 15 / 0.65) 45%, rgb(5 6 15 / 0.1) 78%, transparent);
  }
  .waves { position: absolute; left: 0; bottom: 4%; width: 200%; height: 200px; z-index: 0; pointer-events: none; opacity: 0.5; }
  .waves path { fill: none; stroke-width: 1.4; vector-effect: non-scaling-stroke; }
  .waves path:nth-child(1) { stroke: rgb(34 211 238 / 0.6); }
  .waves path:nth-child(2) { stroke: rgb(139 92 246 / 0.6); }
  .waves path:nth-child(3) { stroke: rgb(236 72 153 / 0.5); }
  .hero-inner { position: relative; z-index: 1; display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: clamp(24px, 4vw, 56px); align-items: start; }

  .portrait { position: relative; width: 200px; aspect-ratio: 1; border-radius: 50%; padding: 5px; margin-top: 4px; isolation: isolate; }
  .portrait::before { /* rotating spectrum ring */
    content: ''; position: absolute; inset: 0; border-radius: 50%; z-index: -1;
    background: conic-gradient(from 0deg, var(--cyan), var(--violet), var(--magenta), var(--cyan));
    box-shadow: 0 0 50px rgb(139 92 246 / 0.55);
  }
  .orbit { /* photon orbiting the portrait */
    position: absolute; inset: -14px; border-radius: 50%; border: 1px dashed rgb(255 255 255 / 0.14); pointer-events: none;
  }
  .orbit::after {
    content: ''; position: absolute; top: -5px; left: 50%; width: 9px; height: 9px; margin-left: -4.5px; border-radius: 50%;
    background: #fff; box-shadow: 0 0 12px 3px var(--cyan);
  }
  .portrait :global(img) { position: relative; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 4px solid var(--night); }

  .eyebrow {
    display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px; border-radius: 999px;
    font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--on-night-2);
    background: rgb(255 255 255 / 0.05); border: 1px solid rgb(255 255 255 / 0.12); margin: 0 0 18px; white-space: pre;
  }
  .eyebrow::before { content: ''; flex: none; width: 7px; height: 7px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }
  h1 { font-size: clamp(3rem, 7vw, 5rem); margin: 0 0 12px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .affil { font-size: 1.15rem; color: #dfe2f5; margin: 0; line-height: 1.5; }
  .intro { font-size: 1.15rem; color: #dfe2f5; max-width: 34em; }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 28px; }

  .hero-aside { position: relative; width: 240px; align-self: stretch; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .hand { font-family: var(--font-hand); font-size: 1.85rem; line-height: 1.2; color: #e4e2ff; margin: 0; display: grid; text-shadow: 0 2px 14px rgb(0 0 0 / 0.7); }
  .hand .l1 { padding-left: 0.8em; }
  .hand .l2 { padding-left: 1.6em; }
  .hand .l3 { padding-left: 1.8em; white-space: nowrap; }
  .hand .l3::after { content: ''; display: block; width: 44px; height: 2px; margin: 10px 0 0 5em; background: var(--grad); }
  .hero-aside :global(.stack) { width: 200px; align-self: flex-end; mix-blend-mode: screen; opacity: 0.95;
    -webkit-mask-image: radial-gradient(closest-side, #000 70%, transparent); mask-image: radial-gradient(closest-side, #000 70%, transparent); }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * { animation: rise 0.8s var(--ease-out) both; }
    .hero-copy > :nth-child(2) { animation-delay: 0.08s; }
    .hero-copy > :nth-child(3) { animation-delay: 0.16s; }
    .hero-copy > :nth-child(5) { animation-delay: 0.24s; }
    .hero-copy > :nth-child(6) { animation-delay: 0.32s; }
    .portrait { animation: rise 0.9s var(--ease-out) both; }
    .portrait::before { animation: spin 10s linear infinite; }
    .orbit { animation: spin 7s linear infinite; }
    .waves { animation: drift 24s linear infinite; }
    .hero-aside :global(.stack) { animation: float 7s ease-in-out infinite; }
    .hand span { animation: rise 0.8s var(--ease-out) both; }
    .hand .l1 { animation-delay: 0.3s; } .hand .l2 { animation-delay: 0.45s; } .hand .l3 { animation-delay: 0.6s; }
  }
  @keyframes drift { to { transform: translateX(-50%); } }

  @media (max-width: 1100px) { .hero-aside { display: none; } .hero-inner { grid-template-columns: auto minmax(0, 1fr); } }
  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .portrait { width: 140px; }
    .hero-art { inset: 0; opacity: 0.4; }
    .eyebrow { white-space: normal; letter-spacing: 0.1em; }
  }

  /* ---------- Section cards ---------- */
  .cards { position: relative; z-index: 2; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; margin-top: -36px; }
  .tile { position: relative; padding: 22px 20px 20px; min-height: 216px; overflow: hidden; }
  .tile-text { display: flex; flex-direction: column; height: 100%; position: relative; z-index: 1; }
  .tile-icon {
    display: grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; margin-bottom: 16px;
    transition: transform 0.5s var(--ease-spring);
  }
  .tile:hover .tile-icon { transform: rotate(-6deg) scale(1.08); }
  .tile-icon.violet { background: var(--purple-bg); color: var(--violet-ink); }
  .tile-icon.teal { background: var(--teal-bg); color: var(--teal); }
  .tile-icon.amber { background: var(--amber-bg); color: var(--amber); }
  .tile-icon.purple { background: rgb(236 72 153 / 0.14); color: var(--magenta); }
  .tile h2 { font-size: 1.3rem; margin: 0 0 6px; }
  .tile h2 a { color: var(--ink); text-decoration: none; }
  .tile h2 a::after { content: ''; position: absolute; inset: -200px; z-index: 2; }
  .tile p { color: var(--ink-2); font-size: 0.95rem; line-height: 1.5; margin: 0 0 14px; max-width: 72%; }
  .tile .link-arrow { margin-top: auto; white-space: nowrap; }
  .tile::after { /* spectrum underline that grows on hover */
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: var(--grad);
    transform: scaleX(0); transform-origin: left; transition: transform 0.6s var(--ease-out);
  }
  .tile:hover::after { transform: scaleX(1); }
  .link-arrow.violet { color: var(--blue-ink); }
  .link-arrow.teal { color: var(--teal); }
  .link-arrow.amber { color: var(--amber); }
  .link-arrow.purple { color: var(--violet-ink); }
  .tile :global(.tile-img) { position: absolute; z-index: 0; right: 10px; top: 14px; width: 40%; max-width: 150px; height: auto; pointer-events: none; transition: transform 0.6s var(--ease-out); }
  .tile:hover :global(.tile-img) { transform: translateY(-4px) scale(1.04); }
  .tile :global(.img-dark) { border-radius: 10px; aspect-ratio: 3 / 4; object-fit: cover; width: 34%; max-width: 112px; }
  .tile :global(.img-light) { top: auto; bottom: 10px; mix-blend-mode: multiply; opacity: 0.85;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 40%); mask-image: linear-gradient(90deg, transparent, #000 40%); }
  .tile:has(.img-dark) p { max-width: 62%; }
  :global([data-theme="dark"]) .tile :global(.img-light) { mix-blend-mode: screen; filter: invert(1) hue-rotate(180deg); opacity: 0.6; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme])) .tile :global(.img-light) { mix-blend-mode: screen; filter: invert(1) hue-rotate(180deg); opacity: 0.6; } }

  @media (max-width: 1100px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .cards { grid-template-columns: 1fr; } }

  /* ---------- Recent posts ---------- */
  .recent { padding-top: 40px; }
  .post-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  @media (max-width: 960px) { .post-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .post-grid { grid-template-columns: 1fr; } }
</style>
