---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import TmmDemo from '@/components/TmmDemo.tsx';
import { researchThemes, skills } from '@/data/cv';
import researchCard from '@/assets/site/research-card.jpg';
import spectrum from '@/assets/site/spectrum.jpg';
import stack from '@/assets/site/photonic-stack.jpg';

const images = { 'research-card': researchCard, spectrum, 'photonic-stack': stack } as const;
---
<Base title="Research" description="Chalcogenide phase-change thin films, multi-level optical switching and active metasurfaces for reconfigurable nanophotonics. Includes an interactive thin-film reflectance demo.">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Research</p>
      <h1>Reconfigurable light with phase-change materials</h1>
      <span class="rule" aria-hidden="true"></span>
      <p>I deposit and characterize chalcogenide phase-change thin films, switch them with engineered optical pulses, and design active metasurfaces that use their non-volatile change in refractive index.</p>
    </div>
  </header>

  <section class="container section">
    <h2 class="section-title">Research themes</h2>
    <div class="themes">
      {researchThemes.map((t, i) => (
        <article class="theme card">
          <Image src={images[t.image]} alt="" width={360} class="theme-img" loading={i === 0 ? 'eager' : 'lazy'} />
          <div class="theme-body">
            <span class="num">0{i + 1}</span>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container section demo" id="thin-film-demo" aria-labelledby="demo-title">
    <div class="section-head">
      <h2 id="demo-title" class="section-title">Interactive: one PCM film, two optical states</h2>
    </div>
    <p class="lede">
      Reflectance of an air / PCM film / substrate stack at normal incidence, computed in your browser with the transfer-matrix
      method (Macleod's characteristic-matrix formulation, <i>N</i> = <i>n</i> − <i>ik</i>). Drag the thickness to find where the
      amorphous and crystalline phases differ most.
    </p>
    <div class="card demo-card">
      <TmmDemo client:visible />
    </div>
    <p class="fine">
      <strong>About the numbers.</strong> The default PCM indices (amorphous 3.9 − 0.05i, crystalline 6.1 − 0.8i) are illustrative,
      rounded values of the size typically reported for Ge₂Sb₂Te₅ near 1550 nm — not measured data. Replace them with your own
      ellipsometry fits. The substrate is semi-infinite, so T is the power entering the substrate (no back-surface reflection), and A is the
      power absorbed in the film (1 − R − T).
    </p>
  </section>

  <section class="container section" aria-labelledby="exp-title">
    <h2 id="exp-title" class="section-title">Technical expertise</h2>
    <div class="skills">
      {skills.map((g) => (
        <article class="skill card">
          <h3><span class="sk-icon"><Icon name={g.icon} size={22} /></span>{g.group}</h3>
          <ul>{g.items.map((s) => <li class="chip">{s}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .themes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
  .theme { overflow: hidden; display: flex; flex-direction: column; }
  .theme :global(.theme-img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--night); }
  .theme-body { padding: 18px 20px 22px; }
  .num { font-family: var(--font-sans); font-size: 0.8rem; letter-spacing: 0.2em; color: var(--violet-ink); }
  .theme h3 { font-size: 1.25rem; margin: 6px 0 8px; }
  .theme p { color: var(--ink-2); margin: 0; font-size: 1rem; }

  .lede { max-width: 72ch; color: var(--ink-2); }
  .demo-card { padding: clamp(16px, 3vw, 28px); }
  .fine { font-size: 0.92rem; color: var(--ink-3); max-width: 80ch; margin-top: 14px; }

  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; margin-top: 20px; }
  .skill { padding: 20px; }
  .skill h3 { display: flex; align-items: center; gap: 12px; font-size: 1.15rem; margin-bottom: 14px; }
  .sk-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--purple-bg); color: var(--violet-ink); flex: none; }
  .skill ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }

  @media (max-width: 900px) { .themes { grid-template-columns: 1fr; } }

  /* ---- TMM demo (React island renders plain class names) ---- */
  .demo :global(.tmm) { display: grid; grid-template-columns: 260px minmax(0, 1fr); grid-template-areas: 'c p' 'c r'; gap: 20px 28px; }
  .demo :global(.tmm-controls) { grid-area: c; display: grid; gap: 14px; align-content: start; }
  .demo :global(fieldset) { border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px 12px; margin: 0; display: grid; gap: 8px; }
  .demo :global(legend) { font-family: var(--font-sans); font-size: 0.8rem; letter-spacing: 0.06em; color: var(--ink-2); padding: 0 6px; display: inline-flex; align-items: center; gap: 6px; }
  .demo :global(.tmm-field) { display: grid; grid-template-columns: 90px 1fr; align-items: center; gap: 10px; font-size: 0.95rem; }
  .demo :global(.tmm-field input), .demo :global(.tmm-field select) {
    width: 100%; font: inherit; font-family: var(--font-sans); font-size: 0.9rem; padding: 6px 8px; border-radius: 6px;
    border: 1px solid var(--line); background: var(--bg); color: var(--ink);
  }
  .demo :global(.tmm-note) { font-size: 0.8rem; color: var(--ink-3); margin: 0; line-height: 1.4; }
  .demo :global(.tmm-plot) { grid-area: p; margin: 0; }
  .demo :global(.tmm-plot svg) { width: 100%; height: auto; }
  .demo :global(.grid) { stroke: var(--line); stroke-width: 1; }
  .demo :global(.tick) { fill: var(--ink-3); font-family: var(--font-sans); font-size: 11px; }
  .demo :global(.axis) { fill: var(--ink-2); font-family: var(--font-sans); font-size: 12px; }
  .demo :global(.curve-a) { fill: none; stroke: #3d7bff; stroke-width: 2.5; }
  .demo :global(.curve-c) { fill: none; stroke: #e0632e; stroke-width: 2.5; }
  .demo :global(.cursor) { stroke: var(--violet); stroke-dasharray: 4 4; stroke-width: 1.5; }
  .demo :global(.dot-a) { fill: #3d7bff; stroke: var(--surface); stroke-width: 2; }
  .demo :global(.dot-c) { fill: #e0632e; stroke: var(--surface); stroke-width: 2; }
  .demo :global(.sw) { display: inline-block; width: 12px; height: 3px; border-radius: 2px; vertical-align: middle; }
  .demo :global(.sw-a) { background: #3d7bff; }
  .demo :global(.sw-c) { background: #e0632e; }
  .demo :global(.tmm-slider) { display: grid; gap: 6px; margin-top: 6px; font-size: 0.95rem; }
  .demo :global(.tmm-slider input) { width: 100%; accent-color: var(--violet); }
  .demo :global(.tmm-readout) { grid-area: r; }
  .demo :global(.tmm-readout table) { border-collapse: collapse; width: 100%; font-family: var(--font-sans); font-size: 0.92rem; font-variant-numeric: tabular-nums; }
  .demo :global(.tmm-readout th), .demo :global(.tmm-readout td) { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--line); }
  .demo :global(.tmm-readout thead th) { color: var(--ink-3); font-weight: 500; }
  .demo :global(.tmm-readout p) { margin: 12px 0 0; font-size: 0.98rem; }
  .demo :global(.tmm-link) { border: 0; background: none; padding: 0; color: var(--blue-ink); text-decoration: underline; cursor: pointer; }
  @media (max-width: 860px) { .demo :global(.tmm) { grid-template-columns: 1fr; grid-template-areas: 'p' 'r' 'c'; } }
</style>
