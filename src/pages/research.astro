---
import { siteImage } from '@/data/siteImages';
import copy from '@/data/editor/research.json';
import { Image } from 'astro:assets';
import { Content as DemoIntro } from '@/data/editor/demoIntro.md';
import { Content as DemoNotes } from '@/data/editor/demoNotes.md';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import LaserSpotCalculator from '@/components/LaserSpotCalculator.tsx';
import OptiStack from '@/components/OptiStack.tsx';
import { researchThemes, skills } from '@/data/cv';

const researchCard = siteImage('researchImg');
const spectrum = siteImage('spectrum');
const stack = siteImage('stack');

const images = { 'research-card': researchCard, spectrum, 'photonic-stack': stack } as const;
---
<Base title="Research" description="Chalcogenide phase-change thin films, multi-level optical switching and active metasurfaces for reconfigurable nanophotonics. Includes the OptiStack multilayer thin-film solver.">
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{copy.heading}</h1>
      <span class="rule" aria-hidden="true"></span>
      <p>{copy.introduction}</p>
    </div>
  </header>

  <section class="container section">
    <h2 class="section-title">{copy.research_themes}</h2>
    <div class="themes">
      {researchThemes.map((t, i) => (
        <article class="theme card">
          <Image src={images[t.image]} alt="" width={360} class="theme-img" loading={i === 0 ? 'eager' : 'lazy'} />
          <div class="theme-body">
            <span class="num">0{i + 1}</span>
            <h3>{t.title}</h3>
            <p>{t.body}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="container section demo" id="thin-film-demo" aria-labelledby="demo-title">
    <div class="section-head">
      <h2 id="demo-title" class="section-title">{copy.demoHeading}</h2>
    </div>
    <div class="lede"><DemoIntro /></div>
    <div class="card demo-card">
      <OptiStack client:visible />
    </div>
    <div class="fine"><DemoNotes /></div>
  </section>

  <section class="container section" id="laser-spot-size" aria-labelledby="laser-heading">
    <h2 id="laser-heading" class="section-title">{copy.laserHeading}</h2>
    <p class="lede">{copy.laserIntro}</p>
    <LaserSpotCalculator client:visible />
  </section>

  <section class="container section" aria-labelledby="exp-title">
    <h2 id="exp-title" class="section-title">{copy.technical_expertise}</h2>
    <div class="skills">
      {skills.map((g) => (
        <article class="skill card">
          <h3><span class="sk-icon"><Icon name={g.icon} size={22} /></span>{g.group}</h3>
          <ul>{g.items.map((s) => <li class="chip">{s}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .themes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 20px; }
  .theme { overflow: hidden; display: flex; flex-direction: column; }
  .theme :global(.theme-img) { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: var(--night); }
  .theme-body { padding: 18px 20px 22px; }
  .num { font-family: var(--font-sans); font-size: 0.8rem; letter-spacing: 0.2em; color: var(--violet-ink); }
  .theme h3 { font-size: 1.25rem; margin: 6px 0 8px; }
  .theme p { color: var(--ink-2); margin: 0; font-size: 1rem; }

  .lede { max-width: 72ch; color: var(--ink-2); }
  .demo-card { padding: clamp(16px, 3vw, 28px); }
  .fine { font-size: 0.92rem; color: var(--ink-3); max-width: 80ch; margin-top: 14px; }

  .skills { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; margin-top: 20px; }
  .skill { padding: 20px; }
  .skill h3 { display: flex; align-items: center; gap: 12px; font-size: 1.15rem; margin-bottom: 14px; }
  .sk-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; background: var(--purple-bg); color: var(--violet-ink); flex: none; }
  .skill ul { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }

  @media (max-width: 900px) { .themes { grid-template-columns: 1fr; } }

</style>
