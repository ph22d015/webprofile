---
import copy from '@/data/editor/blog.json';
import BlogIndex from '@/components/BlogIndex.astro';
import { getPosts } from '@/lib/posts';

const posts = await getPosts();
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---
<BlogIndex
  posts={posts}
  allTags={allTags}
  heading={copy.heading}
  intro={copy.intro}
/>
