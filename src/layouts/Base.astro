---
import '@fontsource-variable/source-serif-4/index.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource-variable/space-grotesk/index.css';
import '@fontsource/caveat/500.css';
import '@/styles/global.css';
import SEO, { type SEOProps } from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Search from '@/components/Search.astro';
import { EMAIL, SITE, sitePath } from '@/consts';

type Props = SEOProps;
const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline src={sitePath("/theme.js")}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#05060f" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={sitePath("/site.webmanifest")} />
    <link rel="sitemap" href={sitePath("/sitemap-index.xml")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Blog`} href={sitePath("/rss.xml")} />
    <SEO {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="scroll-progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Search />
    <span hidden data-u={EMAIL.user} data-d={EMAIL.domain} data-mail-src></span>
    <script>
      // Assemble the e-mail address only in the browser, so it never appears in the static HTML.
      const src = document.querySelector<HTMLElement>('[data-mail-src]');
      const addr = src ? `${src.dataset.u}@${src.dataset.d}` : '';
      document.querySelectorAll<HTMLAnchorElement>('[data-mail]').forEach((a) => (a.href = `mailto:${addr}`));

      // Scroll reveal: tag cards and headings, stagger siblings, show once they enter the viewport.
      const targets = document.querySelectorAll<HTMLElement>('main .card, main .section-title, main .section-head, main [data-reveal]');
      if ('IntersectionObserver' in window) {
        // Hide-until-revealed CSS only applies once this script is running, so a failed script never hides content.
        document.documentElement.classList.add('js');
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
        targets.forEach((el) => {
          // React islands own their DOM; mutating it would be undone on re-render.
          if (el.closest('.page-hero, .hero, astro-island')) return;
          const sibs = [...(el.parentElement?.children ?? [])].filter((c) => c.classList.contains('card'));
          el.style.setProperty('--i', String(Math.min(Math.max(sibs.indexOf(el), 0), 8)));
          el.dataset.reveal = '';
          io.observe(el);
        });
      }

      // Pointer spotlight on cards (CSS reads --mx/--my).
      document.addEventListener('pointermove', (e) => {
        const card = (e.target as Element | null)?.closest?.<HTMLElement>('.card');
        if (!card) return;
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', `${e.clientX - r.left}px`);
        card.style.setProperty('--my', `${e.clientY - r.top}px`);
      }, { passive: true });
    </script>
  </body>
</html>
