---
import '@fontsource-variable/source-serif-4/index.css';
import '@fontsource-variable/inter/index.css';
import '@fontsource/caveat/500.css';
import '@/styles/global.css';
import SEO, { type SEOProps } from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Search from '@/components/Search.astro';
import { EMAIL, SITE, sitePath } from '@/consts';

type Props = SEOProps;
const props = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070b1d" />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href={sitePath("/favicon.svg")} type="image/svg+xml" />
    <link rel="manifest" href={sitePath("/site.webmanifest")} />
    <link rel="sitemap" href={sitePath("/sitemap-index.xml")} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Blog`} href={sitePath("/rss.xml")} />
    <SEO {...props} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Search />
    <span hidden data-u={EMAIL.user} data-d={EMAIL.domain} data-mail-src></span>
    <script>
      // Assemble the e-mail address only in the browser, so it never appears in the static HTML.
      const src = document.querySelector<HTMLElement>('[data-mail-src]');
      const addr = src ? `${src.dataset.u}@${src.dataset.d}` : '';
      document.querySelectorAll<HTMLAnchorElement>('[data-mail]').forEach((a) => {
        a.href = `mailto:${addr}`;
        if (a.hasAttribute('data-mail-text')) a.textContent = addr;
      });
    </script>
  </body>
</html>
