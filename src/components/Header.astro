---
import Icon from './Icon.astro';
import { NAV, SITE, SOCIAL, sitePath } from '@/consts';

const trim = (p: string) => p.replace(/\/+$/, '');
const here = trim(sitePath(Astro.url.pathname));
const isActive = (href: string) => {
  const h = trim(sitePath(href));
  return href === '/' ? here === h : here === h || here.startsWith(h + '/');
};
---
<header class="site-header" data-header>
  <div class="bar container">
    <a class="brand" href={sitePath("/")} aria-label={`${SITE.name}, home`}>
      <Icon name="pulse" size={34} class="brand-mark" />
      <span>{SITE.name}</span>
    </a>

    <nav class="nav" aria-label="Main" id="site-nav" data-nav>
      <ul>
        {NAV.map((item) => (
          <li>
            <a href={sitePath(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      {SOCIAL.linkedin && (
        <a class="icon-btn hide-sm" href={SOCIAL.linkedin} rel="me noopener noreferrer" target="_blank" aria-label="LinkedIn profile">
          <Icon name="linkedin" />
        </a>
      )}
      {SOCIAL.github && (
        <a class="icon-btn hide-sm" href={SOCIAL.github} rel="me noopener noreferrer" target="_blank" aria-label="GitHub profile">
          <Icon name="github" />
        </a>
      )}
      <a class="icon-btn hide-sm" href={sitePath("/about/#contact")} data-mail aria-label="Send an email">
        <Icon name="mail" />
      </a>
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Dark theme" aria-pressed="false" hidden>
        <Icon name="moon" class="i-moon" />
        <Icon name="sun" class="i-sun" />
      </button>
      <button class="icon-btn" type="button" data-search-open aria-label="Search the site" aria-haspopup="dialog">
        <Icon name="search" />
      </button>
      <button class="icon-btn menu-btn" type="button" data-menu aria-controls="site-nav" aria-expanded="false" aria-label="Open menu">
        <Icon name="menu" class="i-open" />
        <Icon name="close" class="i-close" />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu]');

  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 12);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const setMenu = (open: boolean) => {
    if (!header || !menuBtn) return;
    header.classList.toggle('menu-open', open);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  window.matchMedia('(min-width: 1201px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });
</script>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50; height: var(--header-h);
    padding-top: 10px; color: var(--on-night); pointer-events: none;
  }
  .bar {
    pointer-events: auto; height: calc(100% - 10px); display: flex; align-items: center; gap: 20px;
    padding: 0 10px 0 18px; border-radius: 999px;
    background: rgb(8 10 24 / 0.45);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06);
    transition: background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .is-scrolled .bar, .menu-open .bar { background: rgb(8 10 24 / 0.82); border-color: rgb(139 92 246 / 0.3); box-shadow: 0 10px 40px rgb(0 0 0 / 0.35), inset 0 1px 0 rgb(255 255 255 / 0.06); }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; font: 600 1.25rem/1 var(--font-display); letter-spacing: -0.02em; white-space: nowrap; }
  .brand :global(.brand-mark) {
    width: 34px; height: 34px; padding: 6px; border-radius: 10px; color: #fff; background: var(--grad);
    box-shadow: 0 0 18px rgb(139 92 246 / 0.6); transition: transform 0.5s var(--ease-spring);
  }
  .brand:hover :global(.brand-mark) { transform: rotate(-8deg) scale(1.08); }

  .nav { margin-inline: auto; }
  .nav ul { list-style: none; display: flex; gap: 2px; margin: 0; padding: 0; }
  .nav a {
    position: relative; display: block; color: var(--on-night-2); text-decoration: none; font: 500 0.95rem/1 var(--font-sans);
    padding: 10px 14px; border-radius: 999px; transition: color 0.2s ease, background-color 0.2s ease;
  }
  .nav a:hover { color: #fff; background: rgb(255 255 255 / 0.07); }
  .nav a[aria-current='page'] { color: #fff; background: rgb(139 92 246 / 0.22); box-shadow: inset 0 0 0 1px rgb(139 92 246 / 0.45); }
  .nav a::after {
    content: ''; position: absolute; left: 50%; bottom: 3px; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%;
    background: var(--cyan); box-shadow: 0 0 8px var(--cyan); transform: scale(0); transition: transform 0.3s var(--ease-spring);
  }
  .nav a[aria-current='page']::after { transform: scale(1); }

  .actions { display: flex; align-items: center; gap: 2px; }
  .icon-btn {
    display: inline-grid; place-items: center; width: 42px; height: 42px; border-radius: 50%;
    color: #fff; background: transparent; border: 0; cursor: pointer; text-decoration: none;
    transition: background-color 0.2s ease, transform 0.3s var(--ease-spring);
  }
  .icon-btn:hover { background: rgb(255 255 255 / 0.1); transform: translateY(-1px); }
  .icon-btn:active { transform: scale(0.92); }
  .icon-btn :global(svg) { transition: transform 0.4s var(--ease-spring); }
  .theme-toggle:hover :global(svg) { transform: rotate(-25deg); }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle :global(.i-sun) { display: none; }
  :global([data-theme='dark']) .theme-toggle :global(.i-sun) { display: block; }
  :global([data-theme='dark']) .theme-toggle :global(.i-moon) { display: none; }
  .menu-btn { display: none; }
  .menu-btn :global(.i-close) { display: none; }
  .menu-open .menu-btn :global(.i-close) { display: block; }
  .menu-open .menu-btn :global(.i-open) { display: none; }

  @media (max-width: 1200px) {
    .menu-btn { display: inline-grid; }
    .actions { margin-left: auto; }
    .nav {
      position: fixed; inset: calc(var(--header-h) + 8px) var(--gutter) auto; margin: 0;
      background: rgb(8 10 24 / 0.94); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px);
      border: 1px solid rgb(139 92 246 / 0.3); border-radius: 22px; box-shadow: 0 20px 60px rgb(0 0 0 / 0.5);
      padding: 10px; visibility: hidden; opacity: 0; transform: translateY(-8px) scale(0.98); transform-origin: top center;
      transition: opacity 0.25s ease, transform 0.35s var(--ease-out), visibility 0s linear 0.35s;
    }
    .menu-open .nav { visibility: visible; opacity: 1; transform: none; transition-delay: 0s; }
    .nav ul { flex-direction: column; gap: 2px; }
    .nav a { padding: 14px 16px; font-size: 1.05rem; border-radius: 14px; }
    .nav a::after { left: auto; right: 18px; bottom: 50%; margin: 0 0 -2px; }
  }
  @media (max-width: 560px) {
    .hide-sm { display: none; }
    .brand { font-size: 1.1rem; }
    .bar { padding-left: 10px; }
  }
</style>
