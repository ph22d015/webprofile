---
import Base from '@/layouts/Base.astro';
import PostCard from '@/components/PostCard.astro';
import { slugify, type Post } from '@/lib/posts';

interface Props { posts: Post[]; allTags: string[]; activeTag?: string; activeCategory?: string; heading: string; intro: string }
const { posts, allTags, activeTag, heading, intro } = Astro.props;
const categories = ['Lab Notes', 'Research', 'Life'] as const;
---
<Base title={heading} description={intro}>
  <header class="page-hero">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h1>{heading}</h1>
      <span class="rule" aria-hidden="true"></span>
      <p>{intro}</p>
    </div>
  </header>

  <section class="container section">
    <div class="filters">
      <div class="seg" role="group" aria-label="Filter by category">
        <button type="button" class="active" data-cat="all" aria-pressed="true">All</button>
        {categories.map((c) => <button type="button" data-cat={c} aria-pressed="false">{c}</button>)}
      </div>
      <ul class="tag-list" aria-label="Tags">
        {activeTag && <li><a class="chip clear" href="/blog/">✕ Clear tag</a></li>}
        {allTags.map((t) => (
          <li><a class:list={['chip', { on: slugify(t) === activeTag }]} href={`/blog/tag/${slugify(t)}/`}>#{t}</a></li>
        ))}
      </ul>
    </div>

    <div class="grid" data-posts>
      {posts.map((p) => <div data-category={p.data.category}><PostCard post={p} /></div>)}
    </div>
    <p class="empty" data-empty hidden>No posts in this category yet.</p>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-cat]');
  const items = document.querySelectorAll<HTMLElement>('[data-posts] > [data-category]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      const cat = b.dataset.cat;
      buttons.forEach((x) => { x.classList.toggle('active', x === b); x.setAttribute('aria-pressed', String(x === b)); });
      let shown = 0;
      items.forEach((it) => {
        const on = cat === 'all' || it.dataset.category === cat;
        it.hidden = !on;
        if (on) shown++;
      });
      if (empty) empty.hidden = shown > 0;
    }),
  );
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; justify-content: space-between; margin-bottom: 28px; }
  .seg { display: inline-flex; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 4px; }
  .seg button { border: 0; background: transparent; padding: 6px 16px; border-radius: 999px; cursor: pointer; color: var(--ink-2); font-size: 0.95rem; }
  .seg button.active { background: var(--grad); color: #fff; }
  .tag-list { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; }
  .tag-list a { text-decoration: none; }
  .tag-list a:hover, .tag-list a.on { border-color: var(--violet); color: var(--violet-ink); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .grid > [hidden] { display: none; }
  .empty { color: var(--ink-2); }
  @media (max-width: 960px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .grid { grid-template-columns: 1fr; } }
</style>
