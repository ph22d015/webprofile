---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE, SOCIAL, sitePath } from '@/consts';
import defaultOg from '@/assets/site/hero-lab.jpg';

export interface SEOProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  modifiedTime?: Date;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = defaultOg,
  imageAlt = 'Laser beam passing through optics on a photonics lab bench',
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
  noindex = false,
  jsonLd = [],
} = Astro.props as SEOProps;

const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title;
const canonical = new URL(sitePath(Astro.url.pathname), Astro.site);
const og = await getImage({ src: image, format: 'jpeg', width: Math.min(image.width, 1200), quality: 82 });
const ogUrl = new URL(sitePath(og.src), Astro.site);

const sameAs = Object.values(SOCIAL).filter(Boolean);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': new URL(sitePath('/#person'), Astro.site).href,
  name: SITE.name,
  url: new URL(sitePath('/'), Astro.site).href,
  jobTitle: 'PhD Researcher',
  affiliation: { '@type': 'CollegeOrUniversity', name: SITE.institution, url: SITE.institutionUrl },
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Jadavpur University' }],
  knowsAbout: ['Phase-change materials', 'Nanophotonics', 'Active metasurfaces', 'Thin-film deposition', 'Optical characterization'],
  address: { '@type': 'PostalAddress', addressLocality: 'Chennai', addressCountry: 'IN' },
  sameAs,
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: Astro.site?.href,
  inLanguage: 'en',
  author: { '@id': person['@id'] },
};
const graph = [person, website, ...jsonLd];
// Escape "<" so no string inside the JSON can ever close the <script> tag.
const ldJson = JSON.stringify(graph).replace(/</g, '\\u003c');
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="author" content={SITE.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title ?? SITE.title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content={String(og.attributes.width ?? '')} />
<meta property="og:image:height" content={String(og.attributes.height ?? '')} />
<meta property="og:image:alt" content={imageAlt} />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<script type="application/ld+json" set:html={ldJson} />
