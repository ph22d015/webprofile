---
// Inline SVG icon set (no icon-font, no external requests, CSP-safe).
export type IconName =
  | 'pulse' | 'linkedin' | 'github' | 'mail' | 'search' | 'arrow' | 'calendar' | 'clock'
  | 'doc' | 'briefcase' | 'pen' | 'scholar' | 'researchgate' | 'orcid' | 'flask' | 'microscope'
  | 'laser' | 'cube' | 'code' | 'download' | 'menu' | 'close' | 'external' | 'rss' | 'pin'
  | 'sun' | 'moon' | 'arrow-up';

interface Props { name: IconName; class?: string; size?: number }
const { name, class: cls, size = 20 } = Astro.props;

const stroke: Partial<Record<IconName, string>> = {
  // wave packet under a Gaussian envelope — the site mark
  pulse: '<path d="M2 12h3.2c.9 0 1.3-1.2 1.8-3 .6-2.3 1.2-5 2.3-5s1.6 3.4 2.2 8c.5 4 1.1 8 2.2 8s1.7-2.7 2.3-5c.5-1.8.9-3 1.8-3H22" />',
  mail: '<rect x="2.5" y="4.5" width="19" height="15" rx="3"/><path d="m3 7 7.6 5.3a2.5 2.5 0 0 0 2.8 0L21 7"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-4.2-4.2"/>',
  arrow: '<path d="M4 12h16M14 6l6 6-6 6"/>',
  calendar: '<rect x="3" y="4.5" width="18" height="16" rx="3"/><path d="M3 9.5h18M8 2.5v4M16 2.5v4"/><circle cx="8" cy="14" r=".6"/><circle cx="12" cy="14" r=".6"/><circle cx="16" cy="14" r=".6"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  doc: '<path d="M14.5 2.5H7a2 2 0 0 0-2 2v15a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7Z"/><path d="M14 2.5V7a1 1 0 0 0 1 1h4M9 13h6M9 17h4"/>',
  briefcase: '<rect x="2.5" y="7" width="19" height="13.5" rx="3"/><path d="M8.5 7V5a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2M2.5 13h19"/>',
  pen: '<path d="M16.9 3.6a2.1 2.1 0 0 1 3 3L8 18.5 3.5 20.5l2-4.5Z"/><path d="m15 5.5 3.5 3.5"/>',
  flask: '<path d="M9.5 2.5h5M10 2.5v6.2L4.2 18.4A2 2 0 0 0 5.9 21.5h12.2a2 2 0 0 0 1.7-3.1L14 8.7V2.5"/><path d="M6.5 15h11"/>',
  microscope: '<path d="M6 21h12M8 18h8M14 21a7 7 0 0 0 4-12.6"/><path d="M9 14h2M9.5 3.5l3 1.7-3.5 6-3-1.7Z"/><path d="m8.5 12 1.5-2.6"/>',
  laser: '<path d="M2.5 12h7"/><rect x="9.5" y="8.5" width="6" height="7" rx="1.5"/><path d="M15.5 12h6"/><path d="M19 8.5 21.5 6M19 15.5l2.5 2.5"/>',
  cube: '<path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7Z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  download: '<path d="M12 3v12M7 10l5 5 5-5"/><path d="M4 17v1.5A2.5 2.5 0 0 0 6.5 21h11a2.5 2.5 0 0 0 2.5-2.5V17"/>',
  menu: '<path d="M4 7h16M4 12h10M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  external: '<path d="M15 3h6v6M21 3l-9 9"/><path d="M18 14v4.5a2.5 2.5 0 0 1-2.5 2.5h-10A2.5 2.5 0 0 1 3 18.5v-10A2.5 2.5 0 0 1 5.5 6H10"/>',
  rss: '<path d="M4 4a16 16 0 0 1 16 16M4 11a9 9 0 0 1 9 9"/><circle cx="5" cy="19" r="1"/>',
  pin: '<path d="M12 21.5s7.5-6.4 7.5-12a7.5 7.5 0 0 0-15 0c0 5.6 7.5 12 7.5 12Z"/><circle cx="12" cy="9.5" r="2.7"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M20.5 14.1A8.5 8.5 0 1 1 9.9 3.5a6.6 6.6 0 0 0 10.6 10.6Z"/>',
  'arrow-up': '<path d="M12 20V4M6 10l6-6 6 6"/>',
};

const fill: Partial<Record<IconName, string>> = {
  linkedin: '<path d="M4.5 3A1.5 1.5 0 1 1 4.5 6a1.5 1.5 0 0 1 0-3ZM3.2 8h2.6v12H3.2zM9 8h2.5v1.7h.04c.35-.66 1.2-1.9 3.1-1.9 3.3 0 3.9 2.1 3.9 4.9V20h-2.6v-6.6c0-1.6-.03-3.6-2.2-3.6-2.2 0-2.5 1.7-2.5 3.5V20H9V8Z"/>',
  github: '<path d="M12 2a10 10 0 0 0-3.2 19.5c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.3-3.4-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.6 2.4 1.1 3 .9.1-.7.4-1.1.6-1.4-2.2-.3-4.6-1.1-4.6-5 0-1.1.4-2 1-2.7-.1-.3-.4-1.3.1-2.7 0 0 .8-.3 2.8 1a9.6 9.6 0 0 1 5 0c1.9-1.3 2.8-1 2.8-1 .5 1.4.2 2.4.1 2.7.6.7 1 1.6 1 2.7 0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.9V21c0 .3.2.6.7.5A10 10 0 0 0 12 2Z"/>',
  scholar: '<path d="M12 3 1.5 9.5 5 11.7V16c2 2.6 4.4 3.8 7 3.8s5-1.2 7-3.8v-4.3l2-1.2V17h1.5V9.5L12 3Zm0 6.2a4.3 4.3 0 1 1 0 8.6 4.3 4.3 0 0 1 0-8.6Z"/>',
  researchgate: '<path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Zm4.2 4.5v9h1.6v-3.6h1l2 3.6h1.9l-2.2-3.9a2.6 2.6 0 0 0 1.5-2.4c0-1.6-1.1-2.7-3-2.7H8.2Zm1.6 1.4h1.1c.9 0 1.4.5 1.4 1.3s-.5 1.3-1.4 1.3H9.8V8.9Zm7.6-.5c-1.4 0-2.2 1-2.2 2.5s.8 2.5 2.2 2.5c.6 0 1.1-.2 1.4-.6v.5c0 .7-.5 1.1-1.2 1.1-.5 0-.9-.2-1.1-.5l-.9.8c.4.6 1.2.9 2 .9 1.5 0 2.5-.8 2.5-2.3V8.5h-1.3v.5c-.3-.4-.8-.6-1.4-.6Zm.2 1.2c.7 0 1.1.5 1.1 1.3s-.4 1.3-1.1 1.3-1.1-.5-1.1-1.3.4-1.3 1.1-1.3Z"/>',
  orcid: '<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20ZM8.2 7.2a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8ZM7.5 10h1.4v7H7.5v-7Zm3.4 0h3c2.6 0 4 1.8 4 3.5 0 1.8-1.4 3.5-4 3.5h-3v-7Zm1.4 1.3v4.4h1.5c1.8 0 2.6-1.1 2.6-2.2 0-1.2-.8-2.2-2.6-2.2h-1.5Z"/>',
};

const isFill = name in fill;
const body = isFill ? fill[name] : stroke[name];
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : 1.6}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={body}
/>
