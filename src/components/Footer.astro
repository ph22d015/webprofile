---
import Icon from './Icon.astro';
import { NAV, PROFILES, SITE, sitePath } from '@/consts';

const onProfile = Astro.url.pathname.replace(/\/+$/, '') === sitePath('/').replace(/\/+$/, '');
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container grid">
    <div>
      <a class="brand" href={sitePath("/")}><Icon name="pulse" size={26} /> {SITE.name}</a>
      <p class="muted">{SITE.department}, {SITE.institution}</p>
      <p class="muted"><Icon name="pin" size={16} class="inline" /> {SITE.location}</p>
    </div>
    <nav aria-label="Footer">
      <ul class="links">
        {NAV.map((n) => <li><a href={sitePath(n.href)}>{n.label}</a></li>)}
        <li><a href={sitePath("/rss.xml")}><Icon name="rss" size={15} class="inline" /> RSS</a></li>
      </ul>
    </nav>
    <div>
      <ul class="social">
        {PROFILES.filter((p) => p.href).map((p) => (
          <li>
            <a href={p.href} rel="me noopener noreferrer" target="_blank" aria-label={p.label}>
              <Icon name={p.icon} />
            </a>
          </li>
        ))}
        <li><a href={sitePath("/about/#contact")} data-mail aria-label="Email"><Icon name="mail" /></a></li>
      </ul>
    </div>
  </div>
  <div class="container base">
    {onProfile && <img src="https://hits.sh/msourav.me/webprofile.svg?label=Profile%20views&amp;color=5b3fe0" alt="Profile views counter" referrerpolicy="no-referrer" class="visit-count" />}
    <p>© {year} {SITE.name}. Words and photographs are my own unless noted.</p>
    <a class="to-top" href="#main"><Icon name="arrow-up" size={16} /> Back to top</a>
  </div>
</footer>

<style>
  .site-footer { position: relative; background: radial-gradient(800px 260px at 85% 0%, rgb(139 92 246 / 0.18), transparent 70%), var(--night); color: var(--on-night-2); margin-top: 48px; font-size: 0.95rem; }
  .site-footer::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 1px; background: var(--grad); opacity: 0.7; }
  .grid { display: grid; grid-template-columns: 1.3fr 2fr auto; gap: 32px; padding: 48px 0 32px; align-items: start; }
  .brand { display: inline-flex; gap: 10px; align-items: center; color: #fff; text-decoration: none; font-size: 1.25rem; font-weight: 600; margin-bottom: 10px; }
  .brand { font-family: var(--font-display); }
  .brand :global(svg) { width: 32px; height: 32px; padding: 6px; border-radius: 10px; color: #fff; background: var(--grad); }
  .muted { margin: 0 0 4px; }
  :global(.inline) { display: inline-block; vertical-align: -2px; }
  .links { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 8px 20px; }
  .links a, .social a { color: var(--on-night-2); text-decoration: none; }
  .links a:hover, .social a:hover { color: #fff; }
  .social { list-style: none; display: flex; gap: 6px; margin: 0; padding: 0; }
  .social a { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 8px; }
  .social a { transition: background-color 0.2s ease, transform 0.3s var(--ease-spring), color 0.2s ease; }
  .social a:hover { background: rgb(139 92 246 / 0.2); transform: translateY(-3px); }
  .base { border-top: 1px solid rgb(255 255 255 / 0.08); padding: 18px 0 28px; font-size: 0.85rem; }
  .visit-count { height: 20px; width: auto; margin-bottom: 8px; }
  .base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
  .base p { margin: 0; }
  .to-top { display: inline-flex; align-items: center; gap: 6px; color: var(--on-night-2); text-decoration: none; }
  .to-top:hover { color: #fff; }
  .to-top :global(svg) { transition: transform 0.3s var(--ease-spring); }
  .to-top:hover :global(svg) { transform: translateY(-3px); }
  @media (max-width: 800px) { .grid { grid-template-columns: 1fr; } }
</style>
